{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bookmarks",
  "version": "0.1.0",
  "identifier": "dev.grachev.bookmarks",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Bookmarks",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "© Kirill Grachev, 2026",
    "shortDescription": "Local-first Markdown notebook",
    "longDescription": "Bookmarks is a local notebook: Markdown notes, folder tree, tags, instant full-text search, version history, an encrypted vault and sync through a folder or WebDAV. Data stays on your device in a single SQLite file.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "Bookmarks"
      }
    }
  }
}
